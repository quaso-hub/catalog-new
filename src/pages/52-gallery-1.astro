---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="PROJECT GALLERY" pageNumber="52" />
    <h2 class="section-title">Project Gallery</h2>
    <div class="divider-accent"></div>
    <div class="gallery-grid">
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Completed OR Room Interior</span>
          <span class="product-image-placeholder__filename">project-gallery-01.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RSUD Anuntaloko Parigi &#8211; 2025</div>
      </div>
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Control Panel Installation</span>
          <span class="product-image-placeholder__filename">project-gallery-02.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RSUD Liun Kendage &#8211; 2024</div>
      </div>
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Wall Panel &amp; Door Detail</span>
          <span class="product-image-placeholder__filename">project-gallery-03.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RSUD Undata Palu &#8211; 2024</div>
      </div>
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Scrub Area &amp; Corridor</span>
          <span class="product-image-placeholder__filename">project-gallery-04.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RS Hermina Makassar &#8211; 2023</div>
      </div>
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">HVAC Diffuser Installation</span>
          <span class="product-image-placeholder__filename">project-gallery-05.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RSUD Datoe Binangkang &#8211; 2023</div>
      </div>
    </div>
    <p class="gallery-note"><em>*Gallery includes additional selected project installations.</em></p>
    <PageFooter />
  </div>
</div>
