---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SUPPORT SYSTEMS" pageNumber="34" />
    <div class="product-page">
      <div class="product-page__image-area">
        <div class="product-image-placeholder product-image-placeholder--full">
          <span class="product-image-placeholder__icon">[IMG]</span>
          <span class="product-image-placeholder__text">Wall Terminal Gas Medis<br>Anesthesia Technical Panel</span>
          <span class="product-image-placeholder__filename">product-wall-terminal.png</span>
        </div>
      </div>
      <div class="product-page__content">
        <h2 class="product-page__title">Wall Terminal Gas Medis</h2>
        <p class="product-page__description">
          Wall-mounted medical gas terminals and electrical outlets serving as backup supply
          points supplementing the pendant system. Available outlets: O&#x2082;, Vacuum, Air,
          Medical Air (3.5&ndash;5 bar), CO&#x2082;, N&#x2082;O. Available in 3 standard connection models.
        </p>
        <div class="product-page__features">
          <h4 class="product-page__features-title">Available Models</h4>
          <ul class="feature-list">
            <li><strong>OHMEDA Connect</strong> - International standard connection</li>
            <li><strong>DIN (German Standard)</strong> - European standard connection</li>
            <li><strong>SIS Screw</strong> - Screw-type connection system</li>
          </ul>
          <p class="feature-note"><em>*DIN and SIS connection variants available on request.</em></p>
        </div>
        <table class="spec-table gas-color-table">
          <thead>
            <tr><th>Gas Type</th><th>OHMEDA</th><th>DIN</th><th>SIS</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>Oxygen (O&#x2082;)</td>
              <td style="color:#16a34a">Green</td>
              <td style="color:#16a34a">Green</td>
              <td style="color:#16a34a">Green</td>
            </tr>
            <tr>
              <td>Medical Air</td>
              <td style="color:#ca8a04">Yellow</td>
              <td style="color:#ca8a04">Yellow</td>
              <td style="color:#ca8a04">Yellow</td>
            </tr>
            <tr>
              <td>Vacuum</td>
              <td>White</td><td>White</td><td>White</td>
            </tr>
            <tr>
              <td>N&#x2082;O</td>
              <td style="color:#2563eb">Blue</td>
              <td style="color:#2563eb">Blue</td>
              <td style="color:#2563eb">Blue</td>
            </tr>
            <tr>
              <td>CO&#x2082;</td>
              <td style="color:#6b7280">Grey</td>
              <td style="color:#6b7280">Grey</td>
              <td style="color:#6b7280">Grey</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <PageFooter />
  </div>
</div>
