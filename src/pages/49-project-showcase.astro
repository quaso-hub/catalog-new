---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="PROJECT REFERENCES" pageNumber="49" />
    <h2 class="section-title">Featured Project</h2>
    <div class="divider-accent"></div>
    <div class="project-card mb-4">
      <div class="project-card__image">
        <div class="product-image-placeholder product-image-placeholder--full">
          <span class="product-image-placeholder__icon">[IMG]</span>
          <span class="product-image-placeholder__text">Project Photo</span>
          <span class="product-image-placeholder__filename">project-ref-liunkendage.png</span>
        </div>
      </div>
      <div class="project-card__content">
        <h3 class="project-card__title">RSD Liun Kendage: Complete MOT Installation</h3>
        <span class="project-card__location">Sulawesi Utara | 2023-2025</span>
        <p class="project-card__description">
          Multiple phase MOT installation for major regional hospital in North Sulawesi.
          Project spans from 2023 to 2025, covering standard operating rooms, catheterization lab,
          cardiovascular surgery suite, and cytotoxic preparation facility.
        </p>
        <div class="project-card__scope">
          <span class="project-card__scope-title">Scope of Work</span>
          <div class="project-card__scope-list">
            <span class="project-card__scope-item">MOT Standard (2023)</span>
            <span class="project-card__scope-item">MOT Cathlab (2024)</span>
            <span class="project-card__scope-item">MOT Kardiovaskuler (2024)</span>
            <span class="project-card__scope-item">Cytotoxic Room (2025)</span>
          </div>
        </div>
      </div>
    </div>
    <div class="callout">
      <h4 class="callout__title">Project Highlight</h4>
      <p class="callout__text">
        Comprehensive multi-year project demonstrating Elfatech's capability in delivering
        complete modular operating theatre solutions for specialized medical facilities
        including catheterization labs and cardiovascular surgery suites.
      </p>
    </div>
    <PageFooter />
  </div>
</div>
