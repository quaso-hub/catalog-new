---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="PROJECT REFERENCES" pageNumber="49" />
    <h2 class="section-title">Proses Pengerjaan</h2>
    <div class="divider-accent"></div>
    <p class="section-subtitle">
      Alur kerja standar PT Teknomed Indo Timur dari awal hingga selesai.
    </p>
    <div class="process-steps">

      <div class="process-step">
        <div class="process-step__number">01</div>
        <div class="process-step__content">
          <h4 class="process-step__title">Survey &amp; Assessment</h4>
          <p class="process-step__desc">
            Pengukuran lapangan, analisis kebutuhan teknis, dan konsultasi dengan
            tim medis dan teknis rumah sakit untuk menentukan spesifikasi ruang.
          </p>
        </div>
      </div>

      <div class="process-step">
        <div class="process-step__number">02</div>
        <div class="process-step__content">
          <h4 class="process-step__title">Perancangan &amp; Engineering</h4>
          <p class="process-step__desc">
            Penyusunan shop drawing, spesifikasi material, dan jadwal instalasi.
            Gambar disetujui bersama tim RS sebelum fabrikasi dimulai.
          </p>
        </div>
      </div>

      <div class="process-step">
        <div class="process-step__number">03</div>
        <div class="process-step__content">
          <h4 class="process-step__title">Fabrikasi Panel</h4>
          <p class="process-step__desc">
            Produksi panel di workshop dengan quality control ketat sebelum pengiriman.
            Panel dikirim ke lapangan dalam kondisi siap pasang.
          </p>
        </div>
      </div>

      <div class="process-step">
        <div class="process-step__number">04</div>
        <div class="process-step__content">
          <h4 class="process-step__title">Instalasi</h4>
          <p class="process-step__desc">
            Pemasangan sistem modular, instalasi HVAC, gas medis, dan listrik
            oleh teknisi terlatih. Koordinasi dengan kontraktor sipil dan MEP lainnya.
          </p>
        </div>
      </div>

      <div class="process-step">
        <div class="process-step__number">05</div>
        <div class="process-step__content">
          <h4 class="process-step__title">Commissioning &amp; Uji Fungsi</h4>
          <p class="process-step__desc">
            Pengujian teknis seluruh sistem: ventilasi, tekanan ruang, gas medis,
            pencahayaan. Validasi parameter ruang operasi sesuai Permenkes.
          </p>
        </div>
      </div>

      <div class="process-step">
        <div class="process-step__number">06</div>
        <div class="process-step__content">
          <h4 class="process-step__title">Serah Terima &amp; Garansi</h4>
          <p class="process-step__desc">
            Penyerahan dokumen as-built, pelatihan operator RS, dan dukungan
            purna jual. Garansi instalasi dan layanan pemeliharaan tersedia.
          </p>
        </div>
      </div>

    </div>
    <PageFooter />
  </div>
</div>
