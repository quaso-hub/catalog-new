---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SUPPORT SYSTEMS" pageNumber="42" />
    <h2 class="section-title">Medical Gas Infrastructure</h2>
    <div class="divider-accent"></div>
    <div class="dual-product-layout">
      <div class="dual-product-card">
        <div class="dual-product-card__image">
          <span>[IMG]</span>
          <span>Header O2</span>
        </div>
        <div class="dual-product-card__content">
          <h3>Header O2</h3>
          <p>Oxygen header included as part of the main medical gas equipment package. Ensures consistent O2 supply distribution throughout the facility.</p>
        </div>
      </div>
      <hr class="product-divider">
      <div class="dual-product-card">
        <div class="dual-product-card__image">
          <span>[IMG]</span>
          <span>Medical Gas Piping</span>
        </div>
        <div class="dual-product-card__content">
          <h3>Medical Gas Piping (Copper)</h3>
          <p>Medical grade copper tube ASTM B-819 for medical gas distribution system. Available in multiple sizes with fittings and brazing materials included.</p>
          <div class="spec-inline">
            <span><strong>Standard:</strong> ASTM B-819</span>
            <span><strong>Sizes:</strong> 1/2", 3/4", 1 1/8"</span>
            <span><strong>Gas:</strong> O2, CO2, Vacuum, Air, N2O</span>
            <span><strong>Includes:</strong> Fittings &amp; brazing materials</span>
          </div>
        </div>
      </div>
    </div>
    <PageFooter />
  </div>
</div>
