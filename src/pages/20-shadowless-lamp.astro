---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ProductPage from '../components/ProductPage.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SURGICAL EQUIPMENT" pageNumber="20" />
    <ProductPage
      title="LED Shadowless Operating Lamp"
      description="LED surgical lamp, dual dome 700/700 configuration. Illuminance &ge;160,000 Lux per dome. Color temperature: 3800/4400/5000K selectable. Color Rendering Index Ra: 93. Total 218 LED bulbs (18&times;6 + 18&times;6). Service life: 50,000 hours. Endoscopy mode available."
      features={[
        'Dual dome (700mm + 700mm) configuration',
        'Central illuminance &ge;160,000 Lux per dome',
        'Endoscopy mode for laparoscopic procedures',
        'Color temperature 3800K/4400K/5000K adjustable',
        'Total irradiance 544 W/m&sup2;, LED lifespan 50,000 hrs',
        '218 LED bulbs total (18&times;6 + 18&times;6)',
      ]}
      specCards={[
        { icon: 'LUX',  label: 'Illuminance', value: '160,000 Lux' },
        { icon: 'CRI',  label: 'CRI',         value: 'Ra: 93' },
        { icon: 'TEMP', label: 'Color Temp',  value: '3800-5000K' },
        { icon: 'LIFE', label: 'LED Life',    value: '50,000 hrs' },
      ]}
      imageFilename="product-shadowless-lamp.png"
      imagePlaceholderText="LED Shadowless Operating Lamp<br>Product Image"
    />
    <PageFooter />
  </div>
</div>
