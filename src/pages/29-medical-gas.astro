---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ProductPage from '../components/ProductPage.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SUPPORT SYSTEMS" pageNumber="29" />
    <ProductPage
      title="Medical Gas Supply System"
      description="Complete medical gas pipeline system providing reliable delivery of oxygen, medical air, vacuum, nitrous oxide, and AGSS to the operating theatre. All outlets conform to OHMEDA international standards ensuring compatibility with standard equipment."
      features={[
        'OHMEDA standard gas-specific outlets (pin-indexed)',
        'Gas types: O&#x2082;, Medical Air, Vacuum, N&#x2082;O, AGSS',
        'Zone valve boxes with visual indicators',
        'Area alarm panels for pressure monitoring',
        'Medical grade copper pipeline (BS EN 13348)',
        'Fully tested and commissioned to HTM 02-01',
      ]}
      specCards={[
        { icon: 'GAS',  label: 'Gases',    value: '5 Types' },
        { icon: 'ELEC', label: 'Standard', value: 'OHMEDA' },
        { icon: 'MAT',  label: 'Pipeline', value: 'Medical Cu' },
        { icon: 'ALM',  label: 'Alarm',    value: 'Area + Master' },
      ]}
      imageFilename="product-medical-gas.png"
      imagePlaceholderText="Medical Gas Outlet System<br>Product Image"
    />
    <PageFooter />
  </div>
</div>
