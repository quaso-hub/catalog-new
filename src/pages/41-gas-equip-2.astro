---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SUPPORT SYSTEMS" pageNumber="41" />
    <h2 class="section-title">Medical Gas Equipment: Alarm &amp; Zone Valve</h2>
    <div class="divider-accent"></div>
    <div class="dual-product-layout">
      <div class="dual-product-card">
        <div class="dual-product-card__image">
          <span>[IMG]</span>
          <span>LED Alarm Gas</span>
        </div>
        <div class="dual-product-card__content">
          <h3>LED Alarm Gas</h3>
          <p>Gas pressure alarm with LED display. Wall-mounted or embedded installation. Applicable for O2, Air, Vac, N2, N2O.</p>
          <div class="spec-inline">
            <span><strong>Input:</strong> 110-240 VAC, 50-60Hz</span>
            <span><strong>Range:</strong> -0.1 ~ 1.0 MPa</span>
            <span><strong>LED Size:</strong> 0.8 inch</span>
            <span><strong>Accuracy:</strong> &plusmn;1.5%</span>
          </div>
        </div>
      </div>
      <hr class="product-divider">
      <div class="dual-product-card">
        <div class="dual-product-card__image">
          <span>[IMG]</span>
          <span>Zone Box Valve 5 Gas</span>
        </div>
        <div class="dual-product-card__content">
          <h3>Zone Box Valve 5 Gas</h3>
          <p>5-gas zone box valve with NFPA/ISO standard, dome loaded regulator, acrylic observation window, stainless steel pressure gauge.</p>
          <div class="spec-inline">
            <span><strong>Gas Point:</strong> 5-GAS</span>
            <span><strong>Size:</strong> 450&times;775&times;103mm</span>
            <span><strong>Standard:</strong> NFPA/ISO</span>
            <span><strong>Valve:</strong> 1/2" to 2-1/2"</span>
          </div>
        </div>
      </div>
    </div>
    <PageFooter />
  </div>
</div>
