---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import SpecTable from '../components/SpecTable.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="DOOR SYSTEMS" pageNumber="14" />
    <SpecTable
      title="Automatic Swing PB/Lead Door: Technical Specifications"
      tableRows={[
        { parameter: 'Door Size',          specification: '1000 &times; 2200 mm (W &times; H)' },
        { parameter: 'Thickness',          specification: '&plusmn;45&ndash;50 mm' },
        { parameter: 'Frame Material',     specification: 'Steel Plate 1.5&ndash;2mm / Stainless Steel' },
        { parameter: 'Door Leaf Material', specification: 'Steel Plate 1.2&ndash;1.5mm / Stainless Steel' },
        { parameter: 'Finishing',          specification: 'Powder Coating / Stainless Steel' },
        { parameter: 'Pb Lead Lining',     specification: 'Plywood 9mm + Rangka Hollow + PIR insulation' },
        { parameter: 'X-Ray Lock',         specification: 'Motise X-Ray Special (LBA)' },
        { parameter: 'View Glass',         specification: 'View Glass Timbal (radiation-shielded)' },
        { parameter: 'Accessories',        specification: 'Onassis, Wilka, Calvis, Griff, Dekson, Kend, etc.' },
      ]}
      callouts={[
        {
          title: 'Radiation Shielding',
          text: 'Door leaf incorporates Pb (Lead) lining throughout to provide radiation attenuation. Motise X-Ray Special lock and View Glass Timbal window maintain shielding continuity across all hardware penetrations.',
        },
      ]}
    />
    <PageFooter />
  </div>
</div>
