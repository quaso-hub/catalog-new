---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ProductCompact from '../components/ProductCompact.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="WALL &amp; CEILING SYSTEMS" pageNumber="09" />
    <div class="compact-section-intro">
      <h3 class="compact-section-intro__title">Finishing Components</h3>
      <p class="compact-section-intro__text">
        Essential finishing element for the modular wall and ceiling system.
        Aluminium corner profile for seamless wall-to-floor and wall-to-ceiling joints.
      </p>
    </div>
    <div class="grid grid--1col">
      <ProductCompact
        title="Curving (Corner Profile R40)"
        description="Corner profile covering wall joints and wall-to-floor/ceiling intersections. Compliant with Permenkes requirements prohibiting sharp corners in operating rooms. Facilitates cleaning."
        specs={[
          { label: 'Material', value: 'Aluminium' },
          { label: 'Radius',   value: '40mm' },
          { label: 'Height',   value: '3000 mm' },
        ]}
        imagePlaceholderText="Curving R40"
        imageFilename="product-curving-r40.png"
      />
    </div>
    <PageFooter />
  </div>
</div>
