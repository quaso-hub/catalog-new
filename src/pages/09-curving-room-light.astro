---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ProductPage from '../components/ProductPage.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="WALL &amp; CEILING SYSTEMS" pageNumber="09" />
    <h2 class="section-title">Curving Corner Profile R40</h2>
    <div class="divider-accent"></div>
    <ProductPage
      title="Curving (Corner Profile R40)"
      description="Aluminium corner profile covering wall-to-floor and wall-to-ceiling intersections. Per Permenkes regulations, operating rooms must have no sharp corners. Smooth curved surface for easy cleaning."
      features={[
        'Radius 40mm, no sharp corners (Permenkes requirement)',
        'Covers wall-to-floor and wall-to-ceiling junctions',
        'Material: Aluminium, lightweight and corrosion-resistant',
        'Smooth curved surface for easy cleaning',
        'Height 3000mm per unit, site-cut to fit',
      ]}
      specCards={[
        { icon: 'MAT', label: 'Material', value: 'Aluminium' },
        { icon: 'R',   label: 'Radius',   value: '40mm' },
        { icon: 'H',   label: 'Height',   value: '3000 mm' },
      ]}
      imageFilename="product-curving-r40.png"
      imagePlaceholderText="Curving R40<br>Corner Profile"
    />
    <PageFooter />
  </div>
</div>
