---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ProductPage from '../components/ProductPage.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="FLOORING, FINISHING &amp; INFRASTRUCTURE" pageNumber="36" />
    <ProductPage
      title="Medical Vinyl Flooring"
      description="Homogeneous vinyl flooring with anti-bacterial, anti-static, anti-eosin, anti-fungal, and anti-betadine properties. Hospital grade: non-slip and easy to clean. Joints sealed with welding rod for smooth surface. Includes leveling work and aluminium plinth (caping + cove)."
      features={[
        'Homogeneous vinyl, 2mm thickness',
        'Anti-bacterial, anti-static, anti-eosin',
        'Anti-fungal, anti-betadine',
        'Hospital grade: non-slip, easy to clean',
        'Welding rod for seamless joints',
        'Includes leveling and aluminium plinth (caping + cove)',
      ]}
      specCards={[
        { icon: 'TYPE', label: 'Type',      value: 'Homogeneous' },
        { icon: 'THK',  label: 'Thickness', value: '2mm' },
        { icon: 'JNT',  label: 'Joint',     value: 'Welding Rod' },
        { icon: 'GRD',  label: 'Grade',     value: 'Hospital' },
      ]}
      imageFilename="product-vinyl-floor.png"
      imagePlaceholderText="Medical Vinyl Flooring<br>Product Image"
    />
    <PageFooter />
  </div>
</div>
