---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="CERTIFICATIONS" pageNumber="46" />
    <h2 class="section-title">Mengapa MOT Modular?</h2>
    <div class="divider-accent"></div>
    <p class="section-subtitle">
      Perbandingan sistem Modular Operating Theatre (MOT) vs konstruksi konvensional
      untuk keperluan evaluasi teknis dalam proses pengadaan.
    </p>
    <table class="spec-table spec-table--comparison mt-4">
      <thead>
        <tr>
          <th>Aspek</th>
          <th>MOT Modular (Elfatech)</th>
          <th>Konstruksi Konvensional</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Waktu Pengerjaan</strong></td>
          <td>Lebih cepat. Panel difabrikasi di workshop, instalasi lapangan minimal.</td>
          <td>Lebih lama. Seluruh pekerjaan dilakukan in-situ, bergantung kondisi lapangan.</td>
        </tr>
        <tr>
          <td><strong>Gangguan Operasi RS</strong></td>
          <td>Minimal. Instalasi bersih, tidak ada pekerjaan basah atau debu berlebih.</td>
          <td>Tinggi. Debu, kebisingan, dan gangguan akses selama konstruksi berlangsung.</td>
        </tr>
        <tr>
          <td><strong>Kontrol Kualitas</strong></td>
          <td>QC dilakukan di workshop sebelum pengiriman. Hasil konsisten dan terukur.</td>
          <td>Tergantung kondisi lapangan dan keahlian tenaga kerja harian.</td>
        </tr>
        <tr>
          <td><strong>Perawatan Jangka Panjang</strong></td>
          <td>Panel dapat dilepas dan diganti per unit jika rusak atau perlu upgrade.</td>
          <td>Kerusakan membutuhkan renovasi besar, mengganggu operasi ruang OK.</td>
        </tr>
        <tr>
          <td><strong>Standar Sterilitas</strong></td>
          <td>Permukaan tanpa sudut tajam (Permenkes), kompatibel dengan sistem HEPA dan LAF.</td>
          <td>Sulit mencapai standar tinggi tanpa spesifikasi material dan detail konstruksi ketat.</td>
        </tr>
        <tr>
          <td><strong>Fleksibilitas Ekspansi</strong></td>
          <td>Sistem dapat dimodifikasi atau diperluas tanpa membongkar struktur utama.</td>
          <td>Perubahan layout membutuhkan renovasi struktural penuh.</td>
        </tr>
      </tbody>
    </table>
    <PageFooter />
  </div>
</div>
