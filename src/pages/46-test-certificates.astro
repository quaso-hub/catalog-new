---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="CERTIFICATIONS" pageNumber="46" />
    <h2 class="section-title">Test Certificates &amp; Standards</h2>
    <div class="divider-accent"></div>
    <div class="test-cert-grid">
      <div class="test-cert-card">
        <span class="test-cert-card__icon">FIRE</span>
        <h4 class="test-cert-card__title">Fire Rating Test</h4>
        <p class="test-cert-card__description">
          Wall and ceiling panels tested to European fire classification standard.
          Achieved Class B-s1, d0 rating with limited combustibility and minimal smoke production.
        </p>
        <span class="test-cert-card__standard">EN 13501-1:2018</span>
      </div>
      <div class="test-cert-card">
        <span class="test-cert-card__icon">AB</span>
        <h4 class="test-cert-card__title">Antibacterial Coating</h4>
        <p class="test-cert-card__description">
          Surface coating tested for antimicrobial effectiveness. Proven &gt;99.9% reduction
          of bacteria including MRSA, E.coli, and Staphylococcus within 24 hours.
        </p>
        <span class="test-cert-card__standard">ISO 22196:2011 (JIS Z 2801)</span>
      </div>
      <div class="test-cert-card">
        <span class="test-cert-card__icon">RAD</span>
        <h4 class="test-cert-card__title">Radiation Leakage Test</h4>
        <p class="test-cert-card__description">
          Lead-lined wall panels and doors tested for radiation shielding performance.
          Verified to meet required Pb equivalent for diagnostic and interventional radiology.
        </p>
        <span class="test-cert-card__standard">GB 18871-2002</span>
      </div>
      <div class="test-cert-card">
        <span class="test-cert-card__icon">TH</span>
        <h4 class="test-cert-card__title">Thermal Insulation Test</h4>
        <p class="test-cert-card__description">
          PIR core panels tested for thermal conductivity and insulation performance.
          Achieving 0.023 W/mK, exceeding requirements for climate-controlled medical environments.
        </p>
        <span class="test-cert-card__standard">EN 14509:2013</span>
      </div>
    </div>
    <PageFooter />
  </div>
</div>
