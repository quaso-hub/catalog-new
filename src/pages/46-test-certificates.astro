---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="TENTANG ELFATECH" pageNumber="46" />
    <h2 class="section-title">Mengapa MOT Modular?</h2>
    <div class="divider-accent"></div>
    <p class="section-subtitle">
      Perbandingan sistem Modular Operating Theatre (MOT) vs konstruksi konvensional
      untuk keperluan evaluasi teknis dalam proses pengadaan.
    </p>
    <table class="spec-table spec-table--comparison mt-4">
      <thead>
        <tr>
          <th>Aspek</th>
          <th>MOT Modular (Elfatech)</th>
          <th>Konstruksi Konvensional</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Waktu Pengerjaan</strong></td>
          <td>Panel diproduksi di workshop, instalasi lapangan lebih singkat dan terprediksi.</td>
          <td>Seluruh pekerjaan in-situ. Durasi bergantung kondisi lapangan, cuaca, dan ketersediaan material.</td>
        </tr>
        <tr>
          <td><strong>Gangguan Operasi RS</strong></td>
          <td>Instalasi kering dan bersih. Kegiatan RS di sekitar area konstruksi tidak terganggu signifikan.</td>
          <td>Pekerjaan basah, debu, dan kebisingan sepanjang masa konstruksi. Akses area terganggu.</td>
        </tr>
        <tr>
          <td><strong>Kontrol Kualitas</strong></td>
          <td>Setiap panel melewati QC di workshop sebelum pengiriman. Hasil terukur dan konsisten.</td>
          <td>Kualitas sangat bergantung pada kondisi lapangan dan kemampuan tenaga kerja harian.</td>
        </tr>
        <tr>
          <td><strong>Perawatan Jangka Panjang</strong></td>
          <td>Panel rusak dapat dilepas dan diganti per unit tanpa pembongkaran struktural.</td>
          <td>Kerusakan umumnya memerlukan renovasi besar yang menghentikan penggunaan ruang.</td>
        </tr>
        <tr>
          <td><strong>Standar Sterilitas</strong></td>
          <td>Permukaan tanpa sudut tajam sesuai Permenkes 40/2022, kompatibel dengan HEPA dan LAF.</td>
          <td>Standar sterilitas tinggi sulit dipenuhi tanpa spesifikasi material dan konstruksi yang sangat ketat.</td>
        </tr>
        <tr>
          <td><strong>Fleksibilitas Ekspansi</strong></td>
          <td>Layout dapat dimodifikasi atau diperluas tanpa membongkar struktur utama.</td>
          <td>Perubahan layout memerlukan renovasi struktural menyeluruh.</td>
        </tr>
      </tbody>
    </table>
    <PageFooter />
  </div>
</div>
