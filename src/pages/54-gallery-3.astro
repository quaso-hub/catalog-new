---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="PROJECT GALLERY" pageNumber="54" />
    <h2 class="section-title">Project Gallery</h2>
    <div class="divider-accent"></div>
    <div class="gallery-grid">
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Modular Panel Assembly</span>
          <span class="product-image-placeholder__filename">project-gallery-11.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RSUD Bitung &#8211; 2024</div>
      </div>
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Hermetic Door Installation</span>
          <span class="product-image-placeholder__filename">project-gallery-12.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RS Bethesda Tomohon &#8211; 2023</div>
      </div>
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Completed Operating Theatre</span>
          <span class="product-image-placeholder__filename">project-gallery-13.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RSUD Minahasa &#8211; 2024</div>
      </div>
    </div>
    <div class="callout callout--teal mt-4">
      <h4 class="callout__title">Trusted by Leading Hospitals</h4>
      <p class="callout__text">
        50+ operating rooms installed across Indonesia since 2020. From government hospitals
        to premium private medical centers, Elfatech is the trusted choice for modular operating
        theatre solutions.
      </p>
    </div>
    <PageFooter />
  </div>
</div>
