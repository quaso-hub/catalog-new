---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import SpecTable from '../components/SpecTable.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SURGICAL EQUIPMENT" pageNumber="21" />
    <SpecTable
      title="Shadowless Lamp: Technical Specifications"
      tableRows={[
        { parameter: 'Configuration',        specification: 'Dual dome 700mm + 700mm' },
        { parameter: 'Light Source',         specification: 'High-power LED array' },
        { parameter: 'Central Illuminance',   specification: '&ge;160,000 Lux' },
        { parameter: 'Color Temperature',     specification: '3800&plusmn;500K / 4400&plusmn;500K / 5000&plusmn;500K (selectable)' },
        { parameter: 'Color Rendering Index', specification: 'Ra: 93' },
        { parameter: 'Light Field Diameter',  specification: '250 &ndash; 300 mm' },
        { parameter: 'Total Power',          specification: '80W + 80W (160W total)' },
        { parameter: 'LED Lifespan',         specification: '&ge;50,000 hours' },
        { parameter: 'Mounting',             specification: 'Ceiling-mounted with spring arm' },
        { parameter: 'Rotation',             specification: '360&deg; horizontal, &plusmn;45&deg; vertical' },
        { parameter: 'Camera',               specification: 'Optional HD camera integration' },
      ]}
      callouts={[
        {
          title: 'Light Field',
          text: 'Light field diameter adjustable from 250-300mm. Total irradiance 544 W/m&sup2; and 534 W/m&sup2;. Best installation height: 2900mm. Power supply: AC 110-240V, 50/60 Hz.',
        },
      ]}
    />
    <PageFooter />
  </div>
</div>
