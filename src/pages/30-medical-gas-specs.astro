---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SUPPORT SYSTEMS" pageNumber="30" />
    <div class="spec-table-page">
      <h2 class="spec-table-page__title">Medical Gas System: Technical Specifications</h2>
      <div class="spec-table-page__content">
        <div class="spec-table-page__table-area">
          <table class="spec-table">
            <thead>
              <tr><th>Gas Type</th><th>Pressure</th><th>Color Code</th></tr>
            </thead>
            <tbody>
              <tr>
                <td>Oxygen (O&#x2082;)</td>
                <td>4.0 bar (400 kPa)</td>
                <td style="color: #16a34a; font-weight: 600;">Green</td>
              </tr>
              <tr>
                <td>Medical Air (4 bar)</td>
                <td>4.0 bar (400 kPa)</td>
                <td style="color: #ca8a04; font-weight: 600;">Yellow</td>
              </tr>
              <tr>
                <td>Vacuum</td>
                <td>-0.6 bar (-60 kPa)</td>
                <td style="font-weight: 600;">White</td>
              </tr>
              <tr>
                <td>Nitrous Oxide (N&#x2082;O)</td>
                <td>4.0 bar (400 kPa)</td>
                <td style="color: #2563eb; font-weight: 600;">Blue</td>
              </tr>
              <tr>
                <td>Carbon Dioxide (CO&#x2082;)</td>
                <td>4.0 bar (400 kPa)</td>
                <td style="color: #6b7280; font-weight: 600;">Grey</td>
              </tr>
              <tr>
                <td>AGSS</td>
                <td>Passive / Active</td>
                <td style="color: #7c3aed; font-weight: 600;">Purple</td>
              </tr>
            </tbody>
          </table>
          <table class="spec-table mt-4">
            <thead>
              <tr><th>Component</th><th>Specification</th></tr>
            </thead>
            <tbody>
              <tr><td>Outlet Standard</td><td>OHMEDA (gas-specific)</td></tr>
              <tr><td>Pipeline Material</td><td>Medical grade copper (BS EN 13348)</td></tr>
              <tr><td>Zone Valves</td><td>Ball valve with visual indicator</td></tr>
              <tr><td>Alarm Panel</td><td>Digital, audible + visual alerts</td></tr>
              <tr><td>Testing Standard</td><td>HTM 02-01 / ISO 7396-1</td></tr>
            </tbody>
          </table>
        </div>
        <div class="spec-table-page__notes">
          <div class="callout">
            <h4 class="callout__title">Safety System</h4>
            <p class="callout__text">
              Each gas line includes zone valve boxes for emergency shut-off, area alarm panels
              for continuous pressure monitoring, and master alarm at the nurse station.
              All connections are gas-specific to prevent cross-connection.
            </p>
          </div>
          <div class="diagram-section mt-4">
            <h4 class="callout__title">Color Coding Reference</h4>
            <object type="image/svg+xml" data="/assets/diagrams/gas-color-coding.svg"
              style="max-width: 100%; height: auto;">Gas Color Coding</object>
          </div>
        </div>
      </div>
    </div>
    <PageFooter />
  </div>
</div>
