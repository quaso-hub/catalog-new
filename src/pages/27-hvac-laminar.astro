---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ProductPage from '../components/ProductPage.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SUPPORT SYSTEMS" pageNumber="27" />
    <ProductPage
      title="Laminar Air Flow System"
      description="Ceiling-mounted LAF diffuser unit providing unidirectional HEPA-filtered clean airflow over the surgical zone. Meets ISO Class 5 (Class 100) requirements per Permenkes No. 7 Tahun 2019. HVAC system specifications: p.28. AHU Double Skin details: p.41."
      features={[
        'AHU Double Skin with PIR insulation and UV-C ultraviolet sterilisation (Philips)',
        'Multi-stage filtration: G4 pre-filter, F8/F9 medium filter',
        'Laminar Air Flow (LAF) diffuser for unidirectional clean airflow over surgical zone',
        'Temperature control: 18&ndash;26&deg;C &plusmn;1&deg;C',
        'Humidity control: 40&ndash;60% RH &plusmn;5%',
        'Compliant with Permenkes No. 7 Tahun 2019',
      ]}
      specCards={[
        { icon: 'LAF',  label: 'Diffuser Size',   value: '2400 &times; 2400mm' },
        { icon: 'VEL',  label: 'Air Velocity',    value: '0.25&ndash;0.45 m/s' },
        { icon: 'ISO',  label: 'ISO Class',       value: 'Class 5 (100)' },
        { icon: 'HEPA', label: 'Filter Rating',   value: 'H14 (99.995%)' },
      ]}
      imageFilename="product-laminar-flow.png"
      imagePlaceholderText="Laminar Air Flow System<br>Product Image"
    />
    <PageFooter />
  </div>
</div>
