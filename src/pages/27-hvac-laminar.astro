---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ProductPage from '../components/ProductPage.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SUPPORT SYSTEMS" pageNumber="27" />
    <ProductPage
      title="HVAC &amp; Laminar Air Flow"
      description="Operating theatre HVAC system comprising two separate components: AHU Double Skin (air handling and conditioning) and Laminar Air Flow diffuser (unidirectional clean airflow over the surgical zone). Both components work together as an integrated system. Full AHU technical specifications are on the following page."
      features={[
        'AHU Double Skin with PIR insulation and UV-C ultraviolet sterilisation (Philips)',
        'Multi-stage filtration: G4 pre-filter, F8/F9 medium filter',
        'Laminar Air Flow (LAF) diffuser for unidirectional clean airflow over surgical zone',
        'Temperature control: 18&ndash;26&deg;C &plusmn;1&deg;C',
        'Humidity control: 40&ndash;60% RH &plusmn;5%',
        'Compliant with Permenkes No. 7 Tahun 2019',
      ]}
      specCards={[
        { icon: 'TEMP', label: 'Temperature', value: '18&ndash;26&deg;C' },
        { icon: 'RH',   label: 'Humidity',    value: '40&ndash;60% RH' },
        { icon: 'UV',   label: 'UV-C Lamp',   value: 'Philips 30&ndash;72W' },
        { icon: 'AHU',  label: 'AHU',         value: 'Double Skin 25mm' },
      ]}
      imageFilename="product-laminar-flow.png"
      imagePlaceholderText="Laminar Air Flow System<br>Product Image"
    />
    <PageFooter />
  </div>
</div>
