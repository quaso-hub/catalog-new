---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="FLOORING, FINISHING &amp; INFRASTRUCTURE" pageNumber="44" />
    <h2 class="section-title">OR Room Accessories: Indicator &amp; Speaker</h2>
    <div class="divider-accent"></div>
    <div class="dual-product-layout">
      <div class="dual-product-card">
        <div class="dual-product-card__image">
          <span>[IMG]</span>
          <span>OR Indicator Lamp</span>
        </div>
        <div class="dual-product-card__content">
          <h3>OR Status Indicator Lamp</h3>
          <p>Status indicator lamp for operating room (on/off/standby). Installed outside OR door for room status visibility.</p>
          <div class="spec-inline">
            <span><strong>Qty:</strong> 1 unit</span>
            <span><strong>Position:</strong> Outside OR door</span>
          </div>
        </div>
      </div>
      <hr class="product-divider">
      <div class="dual-product-card">
        <div class="dual-product-card__image">
          <span>[IMG]</span>
          <span>Active Speaker System</span>
        </div>
        <div class="dual-product-card__content">
          <h3>Active Speaker System</h3>
          <p>Active speakers for communication and background music in the operating room. Ceiling-mounted for even sound coverage throughout the OR.</p>
          <div class="spec-inline">
            <span><strong>Qty:</strong> 2 units</span>
            <span><strong>Mount:</strong> Ceiling</span>
          </div>
        </div>
      </div>
    </div>
    <PageFooter />
  </div>
</div>
