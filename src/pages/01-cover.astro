---
---

<div class="page p-0">
  <div class="cover-v3">

    <!-- Full-bleed background photo -->
    <img src="/assets/images/cover-hero.svg" alt="" class="cover-v3__bg" aria-hidden="true">

    <!-- Dark overlay - gradient from bottom -->
    <div class="cover-v3__overlay"></div>

    <!-- Top bar: logo + company -->
    <div class="cover-v3__topbar">
      <img src="/assets/logos/logo-elfatech-hd.svg" alt="Elfatech" class="cover-v3__logo">
      <div class="cover-v3__company">PT Teknomed Indo Timur</div>
    </div>

    <!-- Center-left: category label -->
    <div class="cover-v3__category">Product Catalogue 2026</div>

    <!-- Main title block — bottom-left -->
    <div class="cover-v3__title-block">
      <h1 class="cover-v3__title">
        <span class="cover-v3__title-line cover-v3__title-line--thin">Modular</span>
        <span class="cover-v3__title-line cover-v3__title-line--main">Operating</span>
        <span class="cover-v3__title-line cover-v3__title-line--main">Theatre</span>
      </h1>
      <div class="cover-v3__rule"></div>
      <p class="cover-v3__sub">Engineering the future of surgical environments</p>
    </div>

    <!-- Bottom right: contact -->
    <div class="cover-v3__contact">
      <span>+62 812-8865-4879</span>
      <span>teknomedindotimurpt@gmail.com</span>
    </div>

    <!-- Bottom accent strip -->
    <div class="cover-v3__strip">
      <span>Clean Room</span>
      <span class="cover-v3__strip-dot">·</span>
      <span>Medical Gas</span>
      <span class="cover-v3__strip-dot">·</span>
      <span>HVAC Laminar</span>
      <span class="cover-v3__strip-dot">·</span>
      <span>Surgical Pendants</span>
    </div>

  </div>
</div>
