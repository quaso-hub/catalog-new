---
---

<div class="page p-0">
  <div class="cover-v4">

    <!-- ── IMAGE LAYERS ── z-index 0–5 -->

    <!-- L1: Real operating room photo — base -->
    <div class="cv6__room-real">
      <img src="/assets/images/hero-fix-asset/operating-room-v2.png" alt="" aria-hidden="true">
    </div>

    <!-- L2: Blueprint/wireframe room — left dominance, screen blend -->
    <div class="cv6__room-wire">
      <img src="/assets/images/hero-fix-asset/operating-room-wireframe-v2.png" alt="" aria-hidden="true">
    </div>

    <!-- L3: Surgical lamp wireframe — upper LEFT, screen blend -->
    <div class="cv6__lamp-wire">
      <img src="/assets/images/hero-fix-asset/surgical-lamp-wireframe-v3.png" alt="" aria-hidden="true">
    </div>

    <!-- Pendant wrapper — single anchor, real + wire share exact transform origin -->
    <div class="cv6__pendant">
      <div class="cv6__pendant-real">
        <img src="/assets/images/hero-fix-asset/surgical-pendant.png" alt="" aria-hidden="true">
      </div>
      <div class="cv6__pendant-wire">
        <img src="/assets/images/hero-fix-asset/surgical-pendant-wireframe.png" alt="" aria-hidden="true">
      </div>
    </div>

    <!-- L6: Atmosphere gradient + vignette -->
    <div class="cv6__atm"></div>
    <div class="cv6__vig"></div>

    <!-- ── TOP BAR ── logo left / company right -->
    <header class="cover-v4__topbar">
      <img src="/assets/logos/logo-elfatech-hd.svg" alt="Elfatech" class="cover-v4__logo">
      <div class="cover-v4__company-block">
        <span class="cover-v4__company-name">PT Teknomed Indo Timur</span>
      </div>
    </header>

    <!-- ── EYEBROW + CATEGORY ── upper-left mid zone -->
    <div class="cover-v4__eyebrow-block">
      <div class="cover-v4__year-mark">
        <span class="cover-v4__year-dash"></span>
        <span class="cover-v4__year-text">2026</span>
      </div>
      <p class="cover-v4__eyebrow">Product Catalogue</p>
    </div>

    <!-- ── MAIN TITLE BLOCK ── dominant lower-left -->
    <div class="cover-v4__title-block">

      <!-- Pre-title discipline label -->
      <p class="cover-v4__pre-title">Modular</p>

      <!-- Main display title — print-scale -->
      <h1 class="cover-v4__title">
        <span class="cover-v4__title-line">Operating</span>
        <span class="cover-v4__title-line">Theatre</span>
      </h1>

    </div>

    <!-- ── BOTTOM BAR ── contact info, no strip -->
    <footer class="cover-v4__footer">
      <div class="cover-v4__contact">
        <span class="cover-v4__contact-label">Contact</span>
        <span class="cover-v4__contact-item">+62 812-8865-4879</span>
        <span class="cover-v4__contact-sep">·</span>
        <span class="cover-v4__contact-item">teknomedindotimurpt@gmail.com</span>
      </div>
    </footer>

  </div>
</div>
