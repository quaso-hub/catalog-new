---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="FLOORING, FINISHING &amp; INFRASTRUCTURE" pageNumber="45" />
    <h2 class="section-title">OR Room Accessories: Power &amp; Lighting</h2>
    <div class="divider-accent"></div>
    <div class="dual-product-layout">
      <div class="dual-product-card">
        <div class="dual-product-card__image">
          <span>[IMG]</span>
          <span>Power Socket Box</span>
        </div>
        <div class="dual-product-card__content">
          <h3>Power Socket Box</h3>
          <p>Electrical power socket box for operating room power requirements. Provides dedicated circuits for medical equipment with proper grounding.</p>
          <div class="spec-inline">
            <span><strong>Qty:</strong> 1 set per OR</span>
            <span><strong>Type:</strong> Medical grade</span>
          </div>
        </div>
      </div>
      <hr class="product-divider">
      <div class="dual-product-card">
        <div class="dual-product-card__image">
          <span>[IMG]</span>
          <span>LED Room Light Panel</span>
        </div>
        <div class="dual-product-card__content">
          <h3>LED Room Light Panel</h3>
          <p>LED Panel IP20 for ambient room illumination. Flush-mounted with ceiling panel for clean aesthetic.</p>
          <div class="spec-inline">
            <span><strong>Power:</strong> 40-45W</span>
            <span><strong>Size:</strong> 297 &times; 1195 &times; 10mm</span>
            <span><strong>Input:</strong> 220-240V, 50/60Hz</span>
            <span><strong>Rating:</strong> IP20, IK02</span>
          </div>
        </div>
      </div>
    </div>
    <PageFooter />
  </div>
</div>
