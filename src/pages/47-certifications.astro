---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="STANDAR TEKNIS" pageNumber="47" />
    <h2 class="section-title">Standar Teknis & Kepatuhan</h2>
    <div class="divider-accent"></div>
    <p class="section-subtitle">
      Kesesuaian sistem MOT Elfatech terhadap Permenkes No. 40 Tahun 2022.
    </p>
    <table class="spec-table mt-4" style="table-layout: fixed;">
      <colgroup>
        <col style="width: 22%;">
        <col style="width: 28%;">
        <col style="width: 50%;">
      </colgroup>
      <thead>
        <tr>
          <th>Parameter</th>
          <th>Standar Permenkes</th>
          <th>Spesifikasi Elfatech</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Suhu ruang operasi</strong></td>
          <td>19&ndash;24 &deg;C</td>
          <td>19&ndash;26 &deg;C</td>
        </tr>
        <tr>
          <td><strong>Kelembaban relatif</strong></td>
          <td>45&ndash;60% RH</td>
          <td>45&ndash;60% RH</td>
        </tr>
        <tr>
          <td><strong>Tekanan udara</strong></td>
          <td>Positif thd koridor</td>
          <td>Tekanan positif terhadap koridor</td>
        </tr>
        <tr>
          <td><strong>Partikel udara</strong></td>
          <td>&le;10 CFU/m&sup3;</td>
          <td>HEPA H14 (efisiensi 99,99%) + laminar airflow</td>
        </tr>
        <tr>
          <td><strong>Kebisingan</strong></td>
          <td>&le;45 dBA</td>
          <td>&le;45 dBA</td>
        </tr>
        <tr>
          <td><strong>Pencahayaan umum</strong></td>
          <td>300&ndash;500 lux</td>
          <td>LED panel 40&ndash;45 W, 12 unit</td>
        </tr>
        <tr>
          <td><strong>Luas minimum</strong></td>
          <td>&ge;36 m&sup2;</td>
          <td>Konfigurasi modular, &ge;36 m&sup2; per layout</td>
        </tr>
        <tr>
          <td><strong>Tinggi plafon</strong></td>
          <td>&ge;3,0 m</td>
          <td>&ge;3,0 m</td>
        </tr>
        <tr>
          <td><strong>Material dinding</strong></td>
          <td>Anti-bakteri, mudah dibersihkan</td>
          <td>HRP Antibacterial steel, PIR 75mm core</td>
        </tr>
        <tr>
          <td><strong>Material lantai</strong></td>
          <td>Vinyl seamless</td>
          <td>Homogeneous vinyl, hospital grade, coving junction</td>
        </tr>
        <tr>
          <td><strong>Pintu</strong></td>
          <td>Hermetic seal</td>
          <td>Automatic hermetic seal</td>
        </tr>
        <tr>
          <td><strong>Proteksi radiasi</strong></td>
          <td>Sesuai BAPETEN</td>
          <td>Pb 2mm wall &amp; door lining + Pb glass</td>
        </tr>
      </tbody>
    </table>

    <p style="font-size: 9px; color: var(--color-neutral-500); margin-top: var(--space-4);">
      *Sistem HVAC mampu beroperasi pada range lebih luas (18&ndash;26&deg;C, 40&ndash;60% RH). Nilai di tabel ini menunjukkan range yang memenuhi persyaratan Permenkes.
    </p>
    <div class="cert-strip">
      <span>Sertifikasi material produk:</span>
      <img src="/assets/logos/badge-ce.svg" alt="CE" />
      <img src="/assets/logos/badge-iso13485.svg" alt="ISO 13485" />
      <img src="/assets/logos/badge-sni.svg" alt="SNI" />
      <span>Dokumen tersedia atas permintaan.</span>
    </div>
    <PageFooter />
  </div>
</div>
