---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import SpecTable from '../components/SpecTable.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SUPPORT SYSTEMS" pageNumber="30" />
    <SpecTable
      title="HVAC System: Technical Specifications"
      tableRows={[
        { parameter: 'Temperature Range', specification: '18&ndash;26&deg;C &plusmn;1&deg;C' },
        { parameter: 'Humidity Range',    specification: '40&ndash;60% RH &plusmn;5%' },
        { parameter: 'UV-C Sterilisation', specification: 'Philips UV-C lamp, 30&ndash;72W' },
        { parameter: 'AHU Construction',  specification: 'Double Skin panel 25mm' },
        { parameter: 'Standard',          specification: 'Permenkes No. 7 Tahun 2019' },
        { parameter: 'LAF Specifications', specification: 'Per project design requirement. Contact our team.' },
      ]}
      callouts={[
        {
          title: 'AHU Double Skin System',
          text: 'Complete AHU specifications including filtration stages (G4 pre-filter, F8/F9 medium filter), fan capacity, and dimensions are detailed in the AHU Double Skin System page (p.43).',
        },
      ]}
      diagramPath="/assets/diagrams/hvac-airflow.svg"
      diagramTitle="Airflow Direction"
    />
    <PageFooter />
  </div>
</div>
