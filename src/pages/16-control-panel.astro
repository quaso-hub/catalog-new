---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ProductPage from '../components/ProductPage.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SURGICAL EQUIPMENT" pageNumber="16" />
    <ProductPage
      title="Surgical Control Panel"
      description="Windows-based smart control panel room with touchscreen interface for centralized management of all operating theatre systems. Programming: Modbus TCP IP. Controls lighting, HVAC, medical gas monitoring, and communication from a single panel. Includes display operating timer and electrical system control."
      features={[
        '15" LCD touchscreen with Windows-based smart interface',
        'Modbus TCP/IP communication protocol',
        'Integrated control for lights, HVAC, gas, and doors',
        'Real-time medical gas pressure monitoring',
        'Integrated surgical timer and countdown display',
        'Intercom and emergency call system',
      ]}
      specCards={[
        { icon: 'LCD',  label: 'Display',    value: '15&quot; LCD Touch' },
        { icon: 'PWR',  label: 'Power',      value: 'AC220V / 50W' },
        { icon: 'MAT',  label: 'Panel',      value: 'SUS 304' },
        { icon: 'CERT', label: 'Protection', value: 'IP54' },
      ]}
      imageFilename="product-control-panel.png"
      imagePlaceholderText="Surgical Control Panel<br><strong>NEW IMAGE REQUIRED</strong>"
    />
    <PageFooter />
  </div>
</div>
