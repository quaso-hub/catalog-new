---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="PROJECT GALLERY" pageNumber="51" />
    <h2 class="section-title">Project Gallery</h2>
    <div class="divider-accent"></div>
    <div class="gallery-grid">
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Operating Theatre Pendant System</span>
          <span class="product-image-placeholder__filename">project-gallery-06.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RS Siloam Manado &#8211; 2024</div>
      </div>
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Surgical Lighting Setup</span>
          <span class="product-image-placeholder__filename">project-gallery-07.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RSUD Noongan &#8211; 2024</div>
      </div>
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Ceiling Panel System</span>
          <span class="product-image-placeholder__filename">project-gallery-08.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RS Advent Manado &#8211; 2023</div>
      </div>
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Gas Outlet Installation</span>
          <span class="product-image-placeholder__filename">project-gallery-09.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RSUD Tondano &#8211; 2023</div>
      </div>
      <div class="gallery-item">
        <div class="product-image-placeholder">
          <span class="product-image-placeholder__text">Wall Corner Return Air Grille</span>
          <span class="product-image-placeholder__filename">project-gallery-10.png</span>
        </div>
        <div class="gallery-item__caption">MOT &#8211; RSUD Kotamobagu &#8211; 2024</div>
      </div>
    </div>
    <p class="gallery-note"><em>*Gallery includes additional selected project installations.</em></p>
    <PageFooter />
  </div>
</div>
