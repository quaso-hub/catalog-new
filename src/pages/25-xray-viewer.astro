---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ProductPage from '../components/ProductPage.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SUPPORT SYSTEMS" pageNumber="25" />
    <ProductPage
      title="LED X-Ray Viewer"
      description="LED X-ray illuminator with dual viewing screens for simultaneous image comparison. LED technology, rated up to 100,000 hours; automatic brightness adjustment."
      features={[
        '<strong>Double screen configuration</strong> for side-by-side image comparison',
        'LED backlight technology',
        '12-step digital dimmer for perfect brightness adjustment',
        'Film activation switch with automatic shutdown',
        'Brightness uniformity &gt; 90%',
      ]}
      specCards={[
        { icon: 'DIM', label: 'Frame Size', value: '880&times;503&times;29mm' },
        { icon: 'VEW', label: 'View Area',  value: '736&times;440mm' },
        { icon: 'PWR', label: 'Power',      value: '30W' },
        { icon: 'LUX', label: 'Brightness', value: '&gt; 10,000 Lux' },
      ]}
      imageFilename="product-xray-viewer-double.png"
      imagePlaceholderText="X-Ray Viewer<br><strong>DOUBLE SCREEN</strong>"
    />
    <PageFooter />
  </div>
</div>
