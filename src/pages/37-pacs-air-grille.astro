---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ProductCompact from '../components/ProductCompact.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="FLOORING, FINISHING &amp; INFRASTRUCTURE" pageNumber="37" />
    <div class="compact-section-intro">
      <h3 class="compact-section-intro__title">Built-In Infrastructure</h3>
      <p class="compact-section-intro__text">
        Storage cabinet and return air grille, both flush-mounted
        within the modular wall system.
      </p>
    </div>
    <div class="grid grid--2col">
      <ProductCompact
        title="PACS Cabinet / Medical Storage"
        description="Medical storage cabinet made from SUS 304 stainless steel. Anti-rust, easy to clean, keeps medical equipment safe and sterile."
        specs={[
          { label: 'Material',  value: 'Stainless Steel SUS 304' },
          { label: 'Dimension', value: '1200 &times; 2000 &times; 400 mm' },
        ]}
        imageFilename="product-pacs-cabinet.png"
        imagePlaceholderText="PACS Cabinet"
      />
      <ProductCompact
        title="Wall Corner Return Air Grille"
        description="Return air grille supplied as part of the HVAC installation package. Installed at operating room wall corners to complete the air circulation loop back to the AHU. Stainless steel construction for hygiene and durability."
        specs={[
          { label: 'Material', value: 'Stainless Steel' },
          { label: 'Function', value: 'Return air to HVAC' },
          { label: 'Note',     value: 'Dimensions per project specification' },
        ]}
        imageFilename="product-air-grille.png"
        imagePlaceholderText="Wall Corner Return Air Grille"
      />
    </div>
    <PageFooter />
  </div>
</div>
