---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import ProductPage from '../components/ProductPage.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="WALL &amp; CEILING SYSTEMS" pageNumber="08" />
    <ProductPage
      title="Modular Ceiling Panel"
      description="Ceiling sandwich using PIR medical insulation panel with HRP Antibacterial 0.5mm coating from Blue Scope, complete with support frame. Installation height 3000mm from floor. Material thickness 75mm. Anti-corrosion, anti-fungal, rust-proof, fire-resistant."
      features={[
        'PIR insulated core, 75mm thickness',
        'HRP Antibacterial 0.5mm on AZ100 steel from Blue Scope',
        'Installation height: 3000mm from floor',
        'Complete with support frame',
        'Anti-corrosion, anti-fungal, rust-proof, fire-resistant',
        'Compatible with ceiling-mounted surgical lighting and pendant brackets',
      ]}
      specCards={[
        { icon: 'HGT',  label: 'Install Height', value: '3000mm' },
        { icon: 'THK',  label: 'Thickness',       value: '75mm' },
        { icon: 'MAT',  label: 'Coating',          value: 'HRP 0.5mm' },
        { icon: 'FIRE', label: 'Fire Rating',      value: 'B-s1, d0' },
      ]}
      imageFilename="product-ceiling-panel.png"
      imagePlaceholderText="Ceiling Panel System<br>Product Image"
    />
    <PageFooter />
  </div>
</div>
