---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import SpecTable from '../components/SpecTable.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SURGICAL EQUIPMENT" pageNumber="17" />
    <SpecTable
      title="Surgical Control Panel: Technical Specifications"
      tableRows={[
        { parameter: 'Display',            specification: '15&quot; TFT LCD Touchscreen' },
        { parameter: 'Resolution',         specification: '1024 &times; 768 px' },
        { parameter: 'Panel Material',     specification: 'SUS 304 stainless steel' },
        { parameter: 'Power Supply',       specification: 'AC220V, 50Hz' },
        { parameter: 'Power Consumption',  specification: '&le;50W' },
        { parameter: 'Protection Rating',  specification: 'IP54' },
        { parameter: 'Mounting',           specification: 'Wall-mounted / recessed' },
        { parameter: 'Lighting Control',   specification: 'Dimming + on/off for surgical &amp; ambient lights' },
        { parameter: 'HVAC Control',       specification: 'Temperature, humidity, fan speed' },
        { parameter: 'Gas Monitoring',     specification: 'O&#x2082;, Air, Vacuum, N&#x2082;O pressure display' },
        { parameter: 'Communication',      specification: 'Intercom, nurse call, emergency alarm' },
        { parameter: 'Timer',              specification: 'Elapsed time, countdown, clock' },
      ]}
      callouts={[
        {
          title: 'Centralized Control',
          text: 'All operating theatre systems are managed from a single intuitive interface, reducing the need for multiple wall-mounted switches and improving surgical workflow efficiency.',
        },
        {
          title: 'Customizable Interface',
          text: 'The touchscreen layout can be customized to match specific surgical department requirements. Multiple user profiles and preset configurations supported.',
          variant: 'teal',
        },
      ]}
    />
    <PageFooter />
  </div>
</div>
