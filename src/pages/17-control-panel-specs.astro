---
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import SpecTable from '../components/SpecTable.astro';
---

<div class="page">
  <div class="page-content">
    <PageHeader category="SURGICAL EQUIPMENT" pageNumber="17" />
    <SpecTable
      title="Surgical Control Panel: Technical Specifications"
      tableRows={[
        { parameter: 'Display',         specification: '15&quot; Touchscreen Interface' },
        { parameter: 'Panel Material',  specification: 'SUS 304 stainless steel' },
        { parameter: 'Control System',  specification: 'Windows Smart Control Panel Room' },
        { parameter: 'Communication',   specification: 'Modbus TCP/IP protocol' },
        { parameter: 'Network',         specification: 'Switch Hub integrated' },
        { parameter: 'Function',        specification: 'Operating Timer &amp; Room Display Control' },
      ]}
      callouts={[
        {
          title: 'Centralized Control',
          text: 'All operating theatre systems are managed from a single intuitive interface, reducing the need for multiple wall-mounted switches and improving surgical workflow efficiency.',
        },
        {
          title: 'Customizable Interface',
          text: 'The touchscreen layout can be customized to match specific surgical department requirements. Multiple user profiles and preset configurations supported.',
          variant: 'teal',
        },
      ]}
    />
    <PageFooter />
  </div>
</div>
