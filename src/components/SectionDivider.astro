---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<div class="section-divider">
  <h2 class="section-divider__title" set:html={title}></h2>
  <div class="divider-accent mx-auto"></div>
  <p class="section-divider__subtitle">{subtitle}</p>
</div>
