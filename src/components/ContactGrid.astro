---
// Static contact grid — used only on page 53, all content is fixed company data
---

<div class="contact-grid">
  <div class="contact-info">
    <div class="contact-item">
      <div class="contact-item__icon">ADDR</div>
      <div class="contact-item__content">
        <span class="contact-item__label">Office</span>
        <span class="contact-item__value">
          PT Teknomed Indo Timur<br>
          Indonesia
        </span>
      </div>
    </div>
    <div class="contact-item">
      <div class="contact-item__icon">TEL</div>
      <div class="contact-item__content">
        <span class="contact-item__label">Phone</span>
        <span class="contact-item__value">+62 812-8865-4879</span>
      </div>
    </div>
    <div class="contact-item">
      <div class="contact-item__icon">EMAIL</div>
      <div class="contact-item__content">
        <span class="contact-item__label">Email</span>
        <span class="contact-item__value">teknomedindotimurpt@gmail.com</span>
      </div>
    </div>
  </div>
  <div class="contact-map">
    <div class="product-image-placeholder product-image-placeholder--full">
      <span class="product-image-placeholder__icon">[MAP]</span>
      <span class="product-image-placeholder__text">Map / Location Image</span>
      <span class="product-image-placeholder__filename">map-location.jpg</span>
    </div>
  </div>
</div>
<div class="contact-cta">
  <h4 class="contact-cta__title">PT Teknomed Indo Timur</h4>
  <p class="contact-cta__text">Your trusted partner for Modular Operating Theatre solutions</p>
</div>
